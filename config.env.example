# Octopus Voice Assistant Configuration
# Copy this to config.env and fill in your settings.

# Porcupine wake word detection (optional)
# Get a free access key at https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=
# Path to custom trained .ppn wake word model
# Train at https://console.picovoice.ai/ by recording "octopus" 3 times

# Vosk speech recognition model
# Download: wget https://alphacephei.com/vosk/models/vosk-model-small-en-gb-0.15.tar.gz
VOSK_MODEL_PATH=vosk-model-small-en-gb-0.15

# Wake word to display in logs
WAKE_WORD=octopus

# Environment mode: Quiet, Moderate, or Loud
# Quiet    = sensitive VAD (home studio, quiet room)
# Moderate = balanced VAD (rehearsal space, moderate noise)
# Loud     = aggressive VAD (live stage, high ambient noise)
ENVIRONMENT=Moderate

# Seconds to wait for a command after wake word detection
COMMAND_TIMEOUT=3

# Path to commands JSON file
COMMAND_CONFIG_PATH=commands.json

# Enable/disable audio processing pipeline (AGC + noise reduction + VAD)
# Disable for troubleshooting or if using an external audio processor
ENABLE_AUDIO_PROCESSING=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# UI settings (used by --gui mode)
# Theme: Dark, Light, Cyberpunk, Ocean, Forest
THEME=Dark
# Overlay position preset: top-right, top-left, bottom-right, bottom-left
OVERLAY_POSITION=top-right
# Custom overlay position (set to -1 to use preset)
OVERLAY_X=-1
OVERLAY_Y=-1
# Close button behavior: ask, minimize, quit
CLOSE_BEHAVIOR=ask
# Remembered input device name (auto-populated by settings)
# INPUT_DEVICE_NAME=
